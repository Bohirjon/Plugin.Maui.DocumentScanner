<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Plugin.Maui.DocumentScanner</RootNamespace>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>

		<!-- NuGet package -->
		<PackageId>Plugin.Maui.DocumentScanner</PackageId>
		<Version>0.1.0</Version>
		<Authors>Bohirjon Akhmedov</Authors>
		<Description>Native document scanning for .NET MAUI: ML Kit document scanner on Android, VisionKit document camera and Vision-based photo cropping on iOS.</Description>
		<PackageTags>maui;document;scanner;scan;mlkit;visionkit;camera;crop</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/Bohirjon/Plugin.Maui.DocumentScanner</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Bohirjon/Plugin.Maui.DocumentScanner</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.GooglePlayServices.MLKit.DocumentScanner" Version="116.0.0.3" />
		<!-- Lifts ML Kit's AndroidX needs above MAUI's pins so consumers avoid NU1107 -->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
	</ItemGroup>

</Project>
